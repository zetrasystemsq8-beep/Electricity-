# ---------- Core ----------
NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Electricity vending provider ----------
# Which provider implementation to use by default. See src/providers/ProviderRegistry.ts
ACTIVE_ELECTRICITY_PROVIDER=vtpass

# VTpass (https://vtpass.com/documentation/) - required for real meter verification + vending.
# Leave blank in dev: the app will run, but any verify/vend call will return a clear
# "provider not configured" error instead of pretending to succeed.
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_EMAIL=

# ---------- Payment processor ----------
# Used to actually collect the naira from the customer before we call the vending provider.
# Paystack is the most common choice for Nigerian consumer apps. Leave blank in dev.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ---------- Notifications (optional, phase 2) ----------
WHATSAPP_PROVIDER_TOKEN=
SMS_PROVIDER_API_KEY=
